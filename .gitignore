.DS_Store
.idea/
.vscode/

# dependencies
node_modules/

# next.js
.next/
.next-dev/
out/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env (never commit)
.env
.env.*

# runtime / site data (never commit)
uploads/
var/

# prisma local artifacts / data (never commit)
prisma/dev.db
prisma/dev.db-*

# local scripts
restart.sh

# local / cache
.local-mailbox/
tsconfig.tsbuildinfo

# optional: keep repo source-only (missing part)
ios/

# prisma local db / backups (never commit)
prisma/*.db
prisma/*.db.*
prisma/*.db.bak_*
prisma/**/*.db
prisma/**/*.db.*

# prisma schema backups (never commit)
prisma/schema.prisma.bak_*
prisma/schema.prisma.bak_pg_*
